  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -u_printf_float -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -u_printf_float -O0 -g3
  OBJECT_DIR = CMakeFiles\CMSIS_DSP.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\CMSIS_DSP.dir\CMSIS_DSP.pdb
  TARGET_FILE = libCMSIS_DSP.a
  TARGET_PDB = libCMSIS_DSP.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\CMSIS_DSP.dir
  RSP_FILE = CMakeFiles\CMSIS_DSP.rsp


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\h7_framework\build\Debug && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\h7_framework -BD:\h7_framework\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\h7_framework\build\Debug && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\h7_framework -BD:\h7_framework\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# D:/h7_framework/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for OBJECT_LIBRARY target STM32_Drivers


#############################################
# Order-only phony target for STM32_Drivers

build cmake_object_order_depends_target_STM32_Drivers: phony || .

build cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Core/Src/system_stm32h7xx.c.obj: C_COMPILER__STM32_Drivers_unscanned_Debug D$:/h7_framework/Core/Src/system_stm32h7xx.c || cmake_object_order_depends_target_STM32_Drivers
  CONFIG = Debug
  DEFINES = -DDEBUG -DSTM32H723xx -DUSE_HAL_DRIVER -DUSE_PWR_LDO_SUPPLY
  DEP_FILE = cmake\stm32cubemx\CMakeFiles\STM32_Drivers.dir\__\__\Core\Src\system_stm32h7xx.c.obj.d
  FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -u_printf_float -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -u_printf_float -O0 -g3 -std=gnu11
  INCLUDES = -ID:/h7_framework/cmake/stm32cubemx/../../Core/Inc -ID:/h7_framework/cmake/stm32cubemx/../../Drivers/STM32H7xx_HAL_Driver/Inc -ID:/h7_framework/cmake/stm32cubemx/../../Drivers/STM32H7xx_HAL_Driver/Inc/Legacy -ID:/h7_framework/cmake/stm32cubemx/../../Middlewares/Third_Party/FreeRTOS/Source/include -ID:/h7_framework/cmake/stm32cubemx/../../Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS_V2 -ID:/h7_framework/cmake/stm32cubemx/../../Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM4F -ID:/h7_framework/cmake/stm32cubemx/../../Drivers/CMSIS/RTOS2/Include -ID:/h7_framework/cmake/stm32cubemx/../../Drivers/CMSIS/Device/ST/STM32H7xx/Include -ID:/h7_framework/cmake/stm32cubemx/../../Drivers/CMSIS/Include
  OBJECT_DIR = cmake\stm32cubemx\CMakeFiles\STM32_Drivers.dir
  OBJECT_FILE_DIR = cmake\stm32cubemx\CMakeFiles\STM32_Drivers.dir\__\__\Core\Src
  TARGET_COMPILE_PDB = cmake\stm32cubemx\CMakeFiles\STM32_Drivers.dir\
